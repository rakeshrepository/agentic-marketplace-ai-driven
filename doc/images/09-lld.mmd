flowchart TB
    subgraph VSCode["VS Code (Developer Machine)"]
        subgraph ChatUI["Copilot Chat UI"]
            INPUT["User Input<br/>Natural Language"]
        end
        
        subgraph MCPClient["VS Code MCP Client"]
            TOOL_DISC["Tool Discovery<br/>• Reads mcp.json<br/>• Lists available tools"]
            HTTP_TRANS["HTTP Transport<br/>• Streamable HTTP<br/>• POST /mcp"]
        end
        
        subgraph Extension["MCP Auth Extension (~310 LOC)"]
            AUTH_PROVIDER["AuthenticationProvider<br/>━━━━━━━━━━━━━━━━━━<br/>• getSessions()<br/>• createSession()<br/>• removeSession()<br/>• onDidChangeSessions"]
            TOKEN_MGR["TokenManager<br/>━━━━━━━━━━━━━━━━━━<br/>• accessToken: Memory (~0ms)<br/>• refreshToken: Keychain<br/>• autoRefresh: every 50min<br/>• exp check: before request"]
            CONFIG_MGR["McpConfigManager<br/>━━━━━━━━━━━━━━━━━━<br/>• ~/.vscode/mcp.json<br/>• Header: Authorization<br/>• URLs per environment"]
            STATUS["StatusBarItem<br/>• ✅ MCP: user@co.com"]
        end
    end

    subgraph GitHubCloud["GitHub Cloud (External)"]
        COPILOT_LLM["GitHub Copilot LLM<br/>━━━━━━━━━━━━━━━━━━<br/>• Model: GPT-4<br/>• Intent Recognition<br/>• Tool Selection<br/>• Parameter Extraction<br/>• Response Formatting"]
    end

    subgraph Secrets["Secrets Management"]
        GH_SEC["GitHub Secrets<br/>━━━━━━━━━━━━━━━━━━<br/>• PING_CLIENT_ID<br/>• PING_CLIENT_SECRET<br/>• KAFKA_SASL_USERNAME<br/>↓ CI/CD deploys to K8s"]
        AWS_SM["AWS Secrets Manager<br/>━━━━━━━━━━━━━━━━━━<br/>• kafka/dev/credentials<br/>• kafka/sit/credentials<br/>• kafka/uat/credentials<br/>• kafka/prod/credentials<br/>↓ Runtime SDK fetch"]
    end

    subgraph AWS["AWS Cloud"]
        subgraph LBLayer["L1: Load Balancer"]
            ALB["ALB<br/>━━━━━━━━━━━━━━━━━━<br/>• mcp.company.com:443<br/>• TLS Termination (ACM)<br/>• Health: /health<br/>• Target: Kong :8000"]
        end
        
        subgraph EKS["EKS Cluster (mcp-system namespace)"]
            subgraph GWLayer["L2: API Gateway"]
                subgraph KongPod["Kong Deployment (2 replicas)"]
                    JWT_PLUGIN["JWT Plugin<br/>• Algo: RS256<br/>• aud: mcp-api<br/>• JWKS cache: 5min"]
                    RATE_LIMIT["Rate Limit Plugin<br/>• 100 req/min/user<br/>• Key: X-Consumer-ID"]
                    ROUTER["Router<br/>• /kafka/dev/* → svc-dev<br/>• /kafka/sit/* → svc-sit<br/>• /kafka/uat/* → svc-uat<br/>• /kafka/prod/* → svc-prod"]
                end
            end
            
            subgraph SvcLayer["L3: Kubernetes Services"]
                SVC_DEV["svc/kafka-mcp-dev<br/>ClusterIP:8080"]
                SVC_SIT["svc/kafka-mcp-sit<br/>ClusterIP:8080"]
                SVC_UAT["svc/kafka-mcp-uat<br/>ClusterIP:8080"]
                SVC_PROD["svc/kafka-mcp-prod<br/>ClusterIP:8080"]
            end
            
            subgraph PodLayer["L4: MCP Server Pods"]
                subgraph DevPods["dev (2 replicas)"]
                    DEV_P1["pod-1"]
                    DEV_P2["pod-2"]
                end
                subgraph SitPods["sit (2 replicas)"]
                    SIT_P1["pod-1"]
                    SIT_P2["pod-2"]
                end
                subgraph UatPods["uat (2 replicas)"]
                    UAT_P1["pod-1"]
                    UAT_P2["pod-2"]
                end
                subgraph ProdPods["prod (3 replicas)"]
                    PROD_P1["pod-1"]
                    PROD_P2["pod-2"]
                    PROD_P3["pod-3"]
                end
            end
            
            subgraph McpApp["MCP Server Application"]
                HTTP_EP["HTTP Endpoint<br/>POST /mcp"]
                TOOL_ROUTER["Tool Router<br/>• list_topics<br/>• describe_topic<br/>• create_topic<br/>• delete_topic"]
                KAFKA_CLIENT["KafkaAdminClient<br/>• bootstrap.servers<br/>• SASL_SSL<br/>• security.protocol"]
            end
        end
        
        subgraph MSK["Amazon MSK"]
            MSK_DEV["MSK Dev<br/>3 brokers"]
            MSK_SIT["MSK SIT<br/>3 brokers"]
            MSK_UAT["MSK UAT<br/>3 brokers"]
            MSK_PROD["MSK Prod<br/>6 brokers"]
        end
    end

    subgraph Corporate["Corporate Identity"]
        PING_AUTH["PingFederate<br/>/as/authorization.oauth2<br/>• Authorization Code Flow"]
        PING_TOKEN["PingFederate<br/>/as/token.oauth2<br/>• Token Exchange<br/>• Refresh Token"]
        PING_JWKS["PingFederate<br/>/pf/JWKS<br/>• Public Keys (RS256)"]
    end

    INPUT -->|"1. List topics on prod"| COPILOT_LLM
    COPILOT_LLM -->|"2. Tool: list_topics, env: prod"| TOOL_DISC
    TOOL_DISC --> HTTP_TRANS
    HTTP_TRANS -->|"3. Get token"| AUTH_PROVIDER
    AUTH_PROVIDER --> TOKEN_MGR
    TOKEN_MGR -->|"Read from memory"| CONFIG_MGR
    
    HTTP_TRANS -->|"4. POST /kafka/prod/mcp<br/>Authorization: Bearer JWT"| ALB
    ALB -->|"5. HTTP :8000"| JWT_PLUGIN
    JWT_PLUGIN --> RATE_LIMIT
    RATE_LIMIT --> ROUTER
    ROUTER -->|"6. /kafka/prod/*"| SVC_PROD
    
    SVC_DEV --> DEV_P1 & DEV_P2
    SVC_SIT --> SIT_P1 & SIT_P2
    SVC_UAT --> UAT_P1 & UAT_P2
    SVC_PROD -->|"7. Round Robin"| PROD_P1 & PROD_P2 & PROD_P3
    
    DEV_P1 & DEV_P2 --> HTTP_EP
    SIT_P1 & SIT_P2 --> HTTP_EP
    UAT_P1 & UAT_P2 --> HTTP_EP
    PROD_P1 & PROD_P2 & PROD_P3 --> HTTP_EP
    
    HTTP_EP --> TOOL_ROUTER
    TOOL_ROUTER --> KAFKA_CLIENT
    
    KAFKA_CLIENT -->|"8. AdminClient.listTopics()"| MSK_PROD
    
    DevPods -.-> MSK_DEV
    SitPods -.-> MSK_SIT
    UatPods -.-> MSK_UAT
    
    TOKEN_MGR -.->|"OAuth: Login"| PING_AUTH
    TOKEN_MGR -.->|"Refresh"| PING_TOKEN
    JWT_PLUGIN -.->|"JWKS fetch"| PING_JWKS
    
    GH_SEC -.->|"Deploy"| EKS
    AWS_SM -.->|"SDK"| McpApp

