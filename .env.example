# ============================================
# LLM Provider Configuration
# ============================================

# LLM Provider: Choose between 'ollama' (open source) or 'openai' (ChatGPT)
LLM_PROVIDER=ollama
# LLM_PROVIDER=openai

# LLM Timeout in milliseconds
LLM_TIMEOUT=120000

# ============================================
# Ollama Configuration (Open Source)
# Use when LLM_PROVIDER=ollama
# ============================================

# Ollama Base URL (use host.docker.internal for Docker Desktop on Mac/Windows)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama Model (options: mistral:latest, llama3.2, gemma:2b, etc.)
OLLAMA_MODEL=mistral:latest

# ============================================
# OpenAI Configuration (ChatGPT)
# Use when LLM_PROVIDER=openai
# ============================================

# OpenAI API Key (required for OpenAI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# OpenAI Model (options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
# gpt-4o-mini is recommended for cost-effectiveness
OPENAI_MODEL=gpt-4o-mini

# OpenAI Base URL (use default unless using Azure OpenAI or proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# How to Switch Between Providers
# ============================================

# Option 1: Use Ollama (Open Source, Free, Local)
# 1. Make sure Ollama is running: ollama serve
# 2. Pull a model: ollama pull mistral:latest
# 3. Set: LLM_PROVIDER=ollama

# Option 2: Use OpenAI (ChatGPT, Paid, Cloud)
# 1. Get API key from https://platform.openai.com/api-keys
# 2. Set: OPENAI_API_KEY=sk-...
# 3. Set: LLM_PROVIDER=openai

# ============================================
# Example Configurations
# ============================================

# For Development (Free, Local)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=mistral:latest

# For Production (Best Quality)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-actual-api-key
# OPENAI_MODEL=gpt-4o-mini
