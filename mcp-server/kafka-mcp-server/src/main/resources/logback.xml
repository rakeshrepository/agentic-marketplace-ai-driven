<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- CRITICAL: Send all logs to STDERR to keep STDOUT clean for JSON-RPC -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger - all logs to stderr -->
    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>

    <!-- Kafka client logging - reduce verbosity -->
    <logger name="org.apache.kafka" level="WARN" />
    <logger name="org.apache.kafka.clients.admin.AdminClientConfig" level="WARN" />
    <logger name="org.apache.kafka.clients.NetworkClient" level="WARN" />
    <logger name="org.apache.kafka.common.metrics" level="WARN" />
    
    <!-- Our MCP server - keep INFO level -->
    <logger name="com.agentic.marketplace.mcp" level="INFO" />
</configuration>
